import Base from "../../layouts/Base.astro";
import { guides, etsyLink } from "../../data/site";
import { articleSchema, breadcrumbSchema } from "../../data/schema";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = guides.find((g) => g.slug === slug);

if (!guide) {
  return Astro.redirect("/guides");
}

const shopHref = etsyLink({
  medium: "guide",
  campaign: guide.slug,
});

const siteBase = new URL("/", Astro.site).toString().replace(/\/$/, "");

const articleData = {
  headline: guide.title,
  description: guide.description,
  path: `/guides/${guide.slug}`,
  datePublished: guide.publishedAt ?? undefined,
  dateModified: guide.updatedAt ?? undefined,
};

const breadcrumbData = {
  path: `/guides/${guide.slug}`,
};

const articleSchemaData = articleSchema(siteBase, articleData);
const breadcrumbSchemaData = breadcrumbSchema(siteBase, [
  { name: "Home", path: "/" },
  { name: "Guides", path: "/guides" },
  { name: guide.title, path: `/guides/${guide.slug}` },
]);

<Base
  title={guide.title}
  description={guide.description}
  schema={[articleSchemaData, breadcrumbSchemaData]}
>
  <article class="guide">
    <p class="eyebrow">Guide</p>
    <h1>{guide.title}</h1>
    <p class="lede">{guide.description}</p>

    <div class="prose">
      {guide.content ?? guide.description}

      <h2>What to expect</h2>
      <p>
        This guide covers the practical steps for {guide.title.toLowerCase()}. You'll
        find a clear method you can use today, along with links to matching tools
        and printables if you want to put it into practice immediately.
      </p>
    </div>
  </article>
</Base>