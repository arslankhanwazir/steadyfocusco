---
import Base from '../layouts/Base.astro';
import { etsyLink } from '../data/site';

const intents = [
	{ label: "Clear my head", href: "/tools/brain-dump", icon: "brain" },
	{ label: "Plan my week", href: "/tools/weekly-reset", icon: "calendar" },
	{ label: "Get schoolwork done", href: "/students", icon: "school" },
	{ label: "Build a routine", href: "/tools/morning-routine", icon: "routine" },
	{ label: "Focus on one thing", href: "/productivity", icon: "focus" },
];

const tools = [
	{ name: "Brain Dump", desc: "Get everything out of your head and sorted into Do Now, Deadlines, and Later.", href: "/tools/brain-dump", tag: "ADHD" },
	{ name: "Weekly Reset", desc: "Turn a scattered week into one clear plan.", href: "/tools/weekly-reset", tag: "Productivity" },
	{ name: "Morning Routine Builder", desc: "Build a routine you'll actually keep.", href: "/tools/morning-routine", tag: "ADHD" },
];
---
<Base title="Planning for overwhelmed minds">
	<section class="hero">
		<div class="hero-content">
			<p class="hero-eyebrow">PLANNING FOR OVERWHELMED MINDS</p>
			<h1>Make planning easier when your brain feels overwhelmed.</h1>
			<p class="hero-lede">Free tools, practical resources, and printable systems that help turn scattered thoughts into clear next steps.</p>
			<div class="hero-actions">
				<a href="/tools/brain-dump" class="btn-primary">Try a free tool</a>
				<a href="#tools" class="btn-secondary">Explore resources</a>
			</div>
		</div>
		
		<div class="hero-visual">
			<div class="scattered-thoughts" id="thoughtsContainer">
				<div class="thought" data-delay="0">Study for exam</div>
				<div class="thought" data-delay="1">Buy groceries</div>
				<div class="thought" data-delay="2">Reply to email</div>
				<div class="thought" data-delay="3">Doctor appointment</div>
				<div class="thought" data-delay="4">Finish assignment</div>
			</div>
			<div class="organized-categories">
				<div class="category">
					<span class="category-label">DO NOW</span>
					<div class="category-items"></div>
				</div>
				<div class="category">
					<span class="category-label">DEADLINE</span>
					<div class="category-items"></div>
				</div>
				<div class="category">
					<span class="category-label">LATER</span>
					<div class="category-items"></div>
				</div>
			</div>
		</div>
	</section>

	<section class="problem-section" id="tools">
		<div class="section-header">
			<h2>What do you need help with?</h2>
			<p class="section-subtitle">Choose the tool that matches your situation</p>
		</div>
		<div class="intents-grid">
			{intents.map(i => (
				<a class="intent-card" href={i.href}>
					<span class="intent-label">{i.label}</span>
					<span class="intent-arrow">→</span>
				</a>
			))}
		</div>
	</section>

	<section class="tools-section">
		<div class="section-header">
			<h2>Tools for when your brain feels full</h2>
			<p class="section-subtitle">Simple, focused tools that work with how your brain actually operates</p>
		</div>
		<div class="tools-grid">
			{tools.map(t => (
				<a class="tool-card" href={t.href}>
					<span class="tool-tag">{t.tag}</span>
					<h3>{t.name}</h3>
					<p>{t.desc}</p>
					<span class="tool-link">Try it free <span class="arrow">→</span></span>
				</a>
			))}
		</div>
	</section>

	<section class="pillars-section">
		<div class="section-header">
			<h2>Start with a problem</h2>
			<p class="section-subtitle">Practical guides for real planning challenges</p>
		</div>
		<div class="pillar-grid">
			<a href="/adhd" class="pillar-card">
				<span class="pillar-number">01</span>
				<h3>ADHD</h3>
				<p>Planning, routines, and systems built around how an ADHD brain actually works.</p>
				<span class="pillar-link">Explore ADHD resources</span>
			</a>
			<a href="/students" class="pillar-card">
				<span class="pillar-number">02</span>
				<h3>Students</h3>
				<p>Homework, study planning, and getting assignments done without the spiral.</p>
				<span class="pillar-link">Explore student resources</span>
			</a>
			<a href="/productivity" class="pillar-card">
				<span class="pillar-number">03</span>
				<h3>Productivity</h3>
				<p>Weekly planning, prioritizing, and routines that don't require willpower you don't have.</p>
				<span class="pillar-link">Explore productivity resources</span>
			</a>
		</div>
	</section>

	<section class="shop-section">
		<div class="shop-content">
			<div class="shop-text">
				<h2>Prefer paper?</h2>
				<p>Take the system offline with printable planners built around the same ideas as the free tools. Instant download, designed to reuse.</p>
				<a class="btn-secondary" href={etsyLink({ medium: "homepage", campaign: "homepage" })} target="_blank" rel="sponsored noopener" data-analytics-event="etsy_click">Browse the shop →</a>
			</div>
			<div class="shop-visual">
				<div class="product-preview">
					<span class="product-badge">Printable</span>
					<div class="product-mockup"></div>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero { max-width: 900px; margin: 3rem auto 4rem; padding: 0 1.5rem; text-align: center; }
	.hero h1 { font-size: clamp(2rem, 5vw, 3rem); max-width: 700px; margin: 0 auto 1rem; }
	.lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 520px; margin: 0 auto 2.5rem; }

	.intents { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
	.intent-card {
		display: flex; align-items: center; gap: 0.5rem;
		background: var(--card); border: 1px solid var(--border); border-radius: 100px;
		padding: 0.7rem 1.3rem; text-decoration: none; color: var(--ink);
		font-weight: 600; font-size: 0.95rem;
		transition: border-color 0.15s, transform 0.15s;
	}
	.intent-card:hover { border-color: var(--primary); transform: translateY(-2px); }
	.check { color: var(--primary); font-family: var(--display); }

	.tools-strip { max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem; }
	.tools-strip h2, .pillars h2, .shop-teaser h2 { text-align: center; margin-bottom: 2rem; font-size: 1.6rem; }
	.tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.tool-card {
		background: var(--card); border: 1px solid var(--border); border-radius: 14px;
		padding: 1.75rem; text-decoration: none; color: var(--ink); display: block;
		transition: box-shadow 0.15s, transform 0.15s;
	}
	.tool-card:hover { box-shadow: 0 8px 24px rgba(43,46,40,0.08); transform: translateY(-3px); }
	.tool-card h3 { font-size: 1.15rem; margin-bottom: 0.4rem; }
	.tool-card p { color: var(--ink-soft); font-size: 0.92rem; margin: 0 0 1rem; }
	.try { color: var(--primary); font-weight: 700; font-size: 0.9rem; }

	.pillars { max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem; }
	.pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.pillar {
		background: var(--primary); color: #fff; border-radius: 14px; padding: 2rem;
		text-decoration: none; display: block; transition: transform 0.15s;
	}
	.pillar:hover { transform: translateY(-3px); }
	.pillar h3 { color: #fff; margin-bottom: 0.5rem; }
	.pillar p { color: rgba(255,255,255,0.85); font-size: 0.92rem; margin: 0; }
	.pillar:nth-child(2) { background: var(--primary-dark); }
	.pillar:nth-child(3) { background: var(--accent); }

	.shop-teaser { max-width: 600px; margin: 0 auto 5rem; padding: 0 1.5rem; text-align: center; }
	.shop-teaser p { color: var(--ink-soft); margin-bottom: 1.5rem; }
	.shop-link {
		display: inline-block; background: var(--ink); color: #fff; text-decoration: none;
		padding: 0.8rem 1.75rem; border-radius: 100px; font-weight: 700;
	}

	@media (max-width: 800px) {
		.tools-grid, .pillar-grid { grid-template-columns: 1fr; }
	}
</style>
