---
import Base from '../layouts/Base.astro';
import { etsyLink } from '../data/site';

const tools = [
	{ name: "Brain Dump", desc: "Clear the noise.", href: "/tools/brain-dump", tag: "ADHD", color: "purple" },
	{ name: "Weekly Reset", desc: "Turn a scattered week into a clear plan.", href: "/tools/weekly-reset", tag: "Productivity", color: "green" },
	{ name: "Morning Routine", desc: "Build a routine you'll actually use.", href: "/tools/morning-routine", tag: "ADHD", color: "amber" },
];

const pillars = [
	{ num: "01", title: "ADHD", desc: "Planning, routines, and systems built around how an ADHD brain actually works.", href: "/adhd", color: "green" },
	{ num: "02", title: "Students", desc: "Homework, study planning, and getting assignments done without the spiral.", href: "/students", color: "amber" },
	{ num: "03", title: "Productivity", desc: "Weekly planning, prioritizing, and routines that don't require willpower.", href: "/productivity", color: "purple" },
];

const siteUrl = new URL(Astro.url.pathname, Astro.site);
const orgSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "SteadyFocusCo",
	"url": new URL("/", Astro.site).toString(),
	"logo": new URL("/logo.png", Astro.site).toString(),
	"description": "ADHD-friendly planners, printables, checklists and free productivity tools designed to reduce overwhelm, improve focus and make planning easier.",
};
const webSiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "SteadyFocusCo",
	"url": new URL("/", Astro.site).toString(),
	"description": "ADHD-friendly planners, printables, checklists and free productivity tools designed to reduce overwhelm, improve focus and make planning easier.",
};
---
<Base
	title="ADHD Planners & Productivity Tools for Overwhelm | SteadyFocusCo"
	description="ADHD-friendly planners, printables, checklists and free productivity tools designed to reduce overwhelm, improve focus and make planning easier."
>
	<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
	<!-- ===== HERO ===== -->
	<section class="hero" id="hero">
		<div class="container">
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">ADHD-friendly planning</p>
					<h1>ADHD planners, printables & <span class="text-accent">productivity tools</span> that reduce overwhelm.</h1>
					<p class="hero-lede">Free ADHD productivity tools, executive-function supports, and printable planners that turn scattered thoughts into clear next steps — built for daily routines and focus.</p>
					<div class="hero-actions">
						<a href="/shop" class="btn btn-primary">Explore Planners</a>
						<a href="/tools" class="btn btn-secondary">Free Tools</a>
					</div>
					<p class="hero-trust">Designed with care <span>·</span> Made to help <span>·</span> Here for you.</p>
				</div>
				<div class="hero-visual">
					<div class="hero-image-wrap">
						<img src="/products/hero-planner.png" alt="SteadyFocusCo weekly planner flat-lay with planner pages, daily focus sheet, and pen" loading="eager" fetchpriority="high" />
						<div class="hero-float-card">
							<p class="hero-float-title">Made for how your brain works.</p>
							<ul class="hero-float-list">
								<li>Reduce overwhelm</li>
								<li>Build routines</li>
								<li>Stay consistent</li>
								<li>Feel more in control</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== FEATURE STRIP ===== -->
	<section class="feature-strip">
		<div class="container">
			<div class="feature-grid">
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.5-1.5 4.5-3 6s-3 3.5-3 5.5"/><path d="M12 2a7 7 0 0 0-7 7c0 2.5 1.5 4.5 3 6s3 3.5 3 5.5"/><circle cx="12" cy="9" r="2.5"/></svg>
					</div>
					<div>
						<p class="feature-title">ADHD-Friendly</p>
						<p class="feature-desc">Designed for real life and real brains.</p>
					</div>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h4"/></svg>
					</div>
					<div>
						<p class="feature-title">Printable & Reusable</p>
						<p class="feature-desc">Use it your way, anytime.</p>
					</div>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 10l5-7 5 7"/><path d="M5 17h14"/><path d="M7 21h10"/></svg>
					</div>
					<div>
						<p class="feature-title">Instant Access</p>
						<p class="feature-desc">Download and start today.</p>
					</div>
				</div>
				<div class="feature">
					<div class="feature-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
					</div>
					<div>
						<p class="feature-title">Made with Care</p>
						<p class="feature-desc">Thoughtfully designed to support you.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: CHAOS ===== -->
	<section class="story" id="story">
		<div class="container">
			<div class="story-inner">
				<div class="story-copy">
					<p class="eyebrow">The problem</p>
					<h2>Your brain isn't a checklist.</h2>
					<p class="section-lede">Scattered thoughts pile up until everything feels urgent. The fix isn't more willpower — it's getting it out of your head and into a system.</p>
				</div>
				<div class="story-visual">
					<img src="/products/brain-dump-card.png" alt="ADHD brain dump printable showing scattered thoughts organized into a clear system" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: SORTING ===== -->
	<section class="sorting">
		<div class="container">
			<div class="sorting-inner">
				<div class="sorting-copy">
					<p class="eyebrow">The method</p>
					<h2>Sort it once. See the next step.</h2>
					<p class="section-lede">Everything lands in one of three places — do it now, it has a deadline, or it can wait. That's the whole system.</p>
				</div>
				<div class="sorting-visual">
					<img src="/products/sort-system-card.png" alt="ADHD planning system organized into Now, Deadline, and Later categories" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: CLARITY ===== -->
	<section class="clarity">
		<div class="container">
			<div class="clarity-inner">
				<p class="eyebrow">The result</p>
				<h2>Clear the noise. Find the next step.</h2>
				<p class="section-lede">A calm, organized plan you can actually start — not another list you'll ignore.</p>
			</div>
		</div>
	</section>

	<!-- ===== TOOLS ===== -->
	<section class="tools" id="tools">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Free tools</p>
				<h2>Tools for when your brain feels full</h2>
			</div>
			<div class="tools-grid">
				{tools.map((t) => (
					<a class={`tool-card c-${t.color}`} href={t.href}>
						<div class="tool-surface">
							<div class="tool-image-wrap">
								<img src={`/products/${t.href.split('/').pop()}-tool-card.png`} alt={`${t.name} tool preview`} loading="lazy" />
							</div>
							<div class="tool-content">
								<span class="tool-tag">{t.tag}</span>
								<h3>{t.name}</h3>
								<p>{t.desc}</p>
								<span class="tool-link">Try it free <span class="arrow">→</span></span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== PATHS ===== -->
	<section class="paths">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Choose your path</p>
				<h2>Start with a problem</h2>
			</div>
			<div class="paths-grid">
				{pillars.map((p) => (
					<a class={`path-card c-${p.color}`} href={p.href}>
						<span class="path-num">{p.num}</span>
						<h3>{p.title}</h3>
						<p>{p.desc}</p>
						<span class="path-link">Explore <span class="arrow">→</span></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== EXPLORE MORE ===== -->
	<section class="explore">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Keep exploring</p>
				<h2>More ways to plan with less overwhelm</h2>
			</div>
			<div class="explore-grid">
				<a class="explore-card" href="/guides">
					<h3>Guides</h3>
					<p>Practical ADHD planning, executive-function, and study guides written in plain language.</p>
					<span class="explore-link">Read the guides <span class="arrow">→</span></span>
				</a>
				<a class="explore-card" href="/printables">
					<h3>Free printables</h3>
					<p>Reusable ADHD printables and checklists you can download and print at home.</p>
					<span class="explore-link">Browse printables <span class="arrow">→</span></span>
				</a>
				<a class="explore-card" href="/shop">
					<h3>Shop</h3>
					<p>ADHD planners and printable systems for students, adults, and daily routines.</p>
					<span class="explore-link">Visit the shop <span class="arrow">→</span></span>
				</a>
			</div>
		</div>
	</section>

	<!-- ===== ETSY / PRINTABLES ===== -->
	<section class="printables">
		<div class="container">
			<div class="printables-inner">
				<svg class="leaf-accent leaf-printables" viewBox="0 0 100 100" aria-hidden="true"><g fill="#fff"><ellipse cx="50" cy="30" rx="7" ry="17" transform="rotate(20 50 30)"/><ellipse cx="65" cy="45" rx="6" ry="14" transform="rotate(55 65 45)"/><ellipse cx="35" cy="45" rx="6" ry="14" transform="rotate(-30 35 45)"/></g></svg>
				<div class="printables-copy">
					<p class="eyebrow">Printables</p>
					<h2>Take the system off-screen.</h2>
					<p class="section-lede">Prefer paper? The same planning systems are available as printable planners — instant download, designed to reuse.</p>
					<a class="btn btn-on-color" href={etsyLink({ medium: "homepage", campaign: "homepage" })} target="_blank" rel="sponsored noopener" data-analytics-event="etsy_click">Browse printable planners →</a>
				</div>
				<div class="printables-visual">
					<div class="planner">
						<div class="planner-page page-back"></div>
						<div class="planner-page page-mid"></div>
						<div class="planner-page page-front">
							<span class="planner-line"></span>
							<span class="planner-line"></span>
							<span class="planner-line short"></span>
						</div>
						<div class="planner-spine"></div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	// ---- Scroll reveal ----
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('revealed');
				revealObserver.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.story, .sorting, .clarity, .tools, .paths, .explore, .printables').forEach((el) => {
		revealObserver.observe(el);
	});
</script>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.eyebrow {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--primary);
		margin: 0 0 1rem;
	}

	.section-lede {
		font-size: 1.15rem;
		color: var(--ink-soft);
		line-height: 1.6;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.85rem;
		border-radius: 10px;
		font-weight: 700;
		font-size: 1rem;
		transition: all var(--duration-fast) ease;
		cursor: pointer;
		text-decoration: none;
	}
	.btn-primary {
		background: var(--primary);
		color: #fff;
		border: none;
		box-shadow: 0 10px 24px rgba(74, 107, 90, 0.35);
	}
	.btn-primary:hover {
		background: var(--primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px rgba(74, 107, 90, 0.42);
	}
	.btn-secondary {
		background: #fff;
		color: var(--primary-dark);
		border: 1px solid var(--border);
		box-shadow: 0 8px 20px rgba(28, 29, 31, 0.10);
	}
	.btn-secondary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px rgba(28, 29, 31, 0.14);
	}
	.btn-on-color {
		background: #fff;
		color: var(--primary-dark);
		border: none;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
	}
	.btn-on-color:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.24);
	}

	/* ===== HERO ===== */
	.hero {
		background: linear-gradient(180deg, #F7F5F0 0%, #FAFAF8 100%);
		padding: 3rem 0 4rem;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: 3rem;
		align-items: center;
	}
	.hero-copy {
		position: relative;
		z-index: 1;
	}
	.hero-copy h1 {
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		margin-bottom: 1.25rem;
	}
	.text-accent {
		color: var(--primary);
	}
	.hero-lede {
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 520px;
		margin-bottom: 1.75rem;
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
	}
	.hero-trust {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--ink-muted);
	}
	.hero-visual {
		position: relative;
	}
	.hero-image-wrap {
		position: relative;
		border-radius: 24px;
		background: #EFECE6;
		border: 1px solid var(--border);
		box-shadow: 0 24px 60px rgba(28, 29, 31, 0.10);
	}
	.hero-image-wrap img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
	}
	.hero-float-card {
		position: absolute;
		left: -24px;
		bottom: 24px;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.1rem 1.25rem;
		box-shadow: 0 16px 40px rgba(28, 29, 31, 0.12);
		max-width: 260px;
	}
	.hero-float-title {
		font-family: var(--display);
		font-weight: 700;
		font-size: 1rem;
		margin: 0 0 0.6rem;
		color: var(--ink);
	}
	.hero-float-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.hero-float-list li {
		font-size: 0.9rem;
		color: var(--ink-soft);
		padding-left: 1.4rem;
		position: relative;
	}
	.hero-float-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--primary);
		font-weight: 700;
	}

	/* ===== FEATURE STRIP ===== */
	.feature-strip {
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: #fff;
		padding: 1.75rem 0;
	}
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
		align-items: center;
	}
	.feature {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}
	.feature-icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--primary-light);
		color: var(--primary-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.feature-icon svg {
		width: 20px;
		height: 20px;
	}
	.feature-title {
		font-family: var(--display);
		font-weight: 700;
		font-size: 0.95rem;
		margin: 0 0 0.15rem;
		color: var(--ink);
	}
	.feature-desc {
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin: 0;
		line-height: 1.4;
	}

	/* ===== SCROLL STORY ===== */
	.story, .sorting, .clarity, .tools, .paths, .explore, .printables {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
	}
	.story.revealed, .sorting.revealed, .clarity.revealed, .tools.revealed, .paths.revealed, .explore.revealed, .printables.revealed {
		opacity: 1;
		transform: translateY(0);
	}

	/* CHAOS */
	.story {
		padding: 4rem 0;
		background: var(--bg-warm);
		overflow-x: hidden;
	}
	.story-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
	}
	.story-copy {
		max-width: 640px;
	}
	.story-copy h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.story-visual img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		border-radius: 20px;
		background: #EFECE6;
		border: 1px solid var(--border);
		box-shadow: 0 20px 50px rgba(28, 29, 31, 0.10);
	}

	/* SORTING */
	.sorting {
		padding: 4rem 0;
		position: relative;
		overflow-x: hidden;
	}
	.sorting-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.sorting-copy h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.sorting-visual img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		border-radius: 20px;
		background: #EFECE6;
		border: 1px solid var(--border);
		box-shadow: 0 20px 50px rgba(28, 29, 31, 0.10);
	}

	/* CLARITY */
	.clarity {
		padding: 4rem 0;
		background: url('/products/clear-next-step-bg.png') center/cover no-repeat;
		text-align: center;
		position: relative;
	}
	.clarity::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(250, 248, 242, 0.68);
		pointer-events: none;
	}
	.clarity-inner {
		position: relative;
		z-index: 1;
	}
	.clarity-inner {
		max-width: 640px;
		margin: 0 auto;
	}
	.clarity h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	/* Homepage section titles */
	.story-copy h2,
	.sorting-copy h2,
	.clarity-inner h2,
	.section-head h2,
	.printables-copy h2 {
		color: var(--primary);
	}

	/* ===== TOOLS ===== */
	.tools {
		padding: 4rem 0;
	}
	.section-head {
		max-width: 640px;
		margin-bottom: 2.5rem;
	}
	.section-head h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		align-items: stretch;
	}
	.tool-card {
		text-decoration: none;
		color: var(--ink);
		display: block;
		height: 100%;
	}
	.tool-surface {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background:
			linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 40%),
			var(--card);
		border: 1px solid var(--border);
		border-radius: 24px;
		box-shadow:
			0 1px 2px rgba(28, 29, 31, 0.04),
			0 10px 24px rgba(28, 29, 31, 0.06),
			0 28px 56px rgba(28, 29, 31, 0.08);
		transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
		overflow: hidden;
	}
	.tool-surface::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, rgba(255,255,255,0.9), rgba(255,255,255,0.4));
		z-index: 1;
	}
	.tool-card:hover .tool-surface {
		transform: translateY(-6px);
