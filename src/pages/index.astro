---
import Base from '../layouts/Base.astro';
import { etsyLink } from '../data/site';

const tools = [
	{ name: "Brain Dump", desc: "Clear the noise.", href: "/tools/brain-dump", tag: "ADHD", color: "purple" },
	{ name: "Weekly Reset", desc: "Turn a scattered week into a clear plan.", href: "/tools/weekly-reset", tag: "Productivity", color: "green" },
	{ name: "Morning Routine", desc: "Build a routine you'll actually use.", href: "/tools/morning-routine", tag: "ADHD", color: "amber" },
];

const pillars = [
	{ num: "01", title: "ADHD", desc: "Planning, routines, and systems built around how an ADHD brain actually works.", href: "/adhd", color: "green" },
	{ num: "02", title: "Students", desc: "Homework, study planning, and getting assignments done without the spiral.", href: "/students", color: "amber" },
	{ num: "03", title: "Productivity", desc: "Weekly planning, prioritizing, and routines that don't require willpower.", href: "/productivity", color: "purple" },
];
---
<Base title="Planning for overwhelmed minds">
	<!-- ===== HERO ===== -->
	<section class="hero" id="hero">
		<div class="hero-copy">
			<p class="eyebrow">Planning for overwhelmed minds</p>
			<h1>Make planning easier when your brain feels overwhelmed.</h1>
			<p class="hero-lede">Free tools and practical systems that turn scattered thoughts into clear next steps.</p>
			<div class="hero-actions">
				<a href="/tools/brain-dump" class="btn btn-primary">Try a free tool</a>
				<a href="#story" class="btn btn-secondary">Explore resources</a>
			</div>
			<div class="hero-trust">
				<span>Free</span><span>·</span><span>No sign-up</span><span>·</span><span>Private</span>
			</div>
		</div>

		<!-- Legible floating task-card visual: color = category, matches copy directly -->
		<div class="hero-stage" id="stage" aria-label="Tasks sorting into now, deadline, and later">
			<svg class="leaf-accent leaf-hero" viewBox="0 0 100 100" aria-hidden="true"><g fill="#6B8F7B"><ellipse cx="70" cy="20" rx="7" ry="18" transform="rotate(35 70 20)"/><ellipse cx="85" cy="35" rx="6" ry="15" transform="rotate(60 85 35)"/><ellipse cx="55" cy="15" rx="6" ry="14" transform="rotate(10 55 15)"/></g></svg>
			<div class="stage-field" id="field">
				<div class="task-card zone-now" style="--x:8%; --y:10%; --r:-6deg; --z:60px;">
					<span class="dot"></span>Reply to email
					<small>Do now</small>
				</div>
				<div class="task-card zone-deadline" style="--x:38%; --y:36%; --r:2deg; --z:120px;">
					<span class="dot"></span>Study for exam
					<small>Deadline · Fri</small>
				</div>
				<div class="task-card zone-later small" style="--x:64%; --y:8%; --r:5deg; --z:20px;">
					<span class="dot"></span>Laundry
					<small>Later</small>
				</div>
				<div class="task-card zone-now small" style="--x:10%; --y:60%; --r:-3deg; --z:40px;">
					<span class="dot"></span>Doctor appt
					<small>Do now</small>
				</div>
				<div class="task-card zone-deadline small" style="--x:56%; --y:64%; --r:4deg; --z:0px;">
					<span class="dot"></span>Finish assignment
					<small>Deadline</small>
				</div>
				<div class="task-card zone-later" style="--x:34%; --y:78%; --r:-4deg; --z:80px;">
					<span class="dot"></span>Buy groceries
					<small>Later</small>
				</div>
			</div>
			<div class="stage-legend">
				<span class="legend-item zone-now">Now</span>
				<span class="legend-item zone-deadline">Deadline</span>
				<span class="legend-item zone-later">Later</span>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: CHAOS ===== -->
	<section class="story" id="story">
		<div class="container">
			<div class="story-head">
				<p class="eyebrow">The problem</p>
				<h2>Your brain isn't a checklist.</h2>
				<p class="section-lede">Scattered thoughts pile up until everything feels urgent. The fix isn't more willpower — it's getting it out of your head and into a system.</p>
			</div>
			<div class="chaos-scene">
				<div class="chaos-chip c1">Buy groceries</div>
				<div class="chaos-chip c2">Reply to email</div>
				<div class="chaos-chip c3">Study for exam</div>
				<div class="chaos-chip c4">Doctor appointment</div>
				<div class="chaos-chip c5">Finish assignment</div>
				<div class="chaos-chip c6">Laundry</div>
				<div class="chaos-chip c7">Project</div>
				<div class="chaos-chip c8">Meeting</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: SORTING ===== -->
	<section class="sorting">
		<div class="container">
			<svg class="leaf-accent leaf-sorting" viewBox="0 0 140 100" aria-hidden="true"><g fill="#97C459"><ellipse cx="20" cy="80" rx="8" ry="20" transform="rotate(-20 20 80)"/><ellipse cx="40" cy="90" rx="7" ry="18" transform="rotate(-5 40 90)"/><ellipse cx="5" cy="60" rx="6" ry="16" transform="rotate(-45 5 60)"/></g></svg>
			<div class="sorting-inner">
				<div class="sorting-copy">
					<p class="eyebrow">The method</p>
					<h2>Sort it once. See the next step.</h2>
					<p class="section-lede">Everything lands in one of three places — do it now, it has a deadline, or it can wait. That's the whole system.</p>
				</div>
				<div class="sorting-visual">
					<div class="sorting-flow">
						<div class="flow-in"><span>Scattered</span></div>
						<div class="flow-arrow">→</div>
						<div class="flow-out">
							<div><strong>Now</strong></div>
							<div><strong>Deadline</strong></div>
							<div><strong>Later</strong></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: CLARITY ===== -->
	<section class="clarity">
		<div class="container">
			<div class="clarity-inner">
				<p class="eyebrow">The result</p>
				<h2>Clear the noise. Find the next step.</h2>
				<p class="section-lede">A calm, organized plan you can actually start — not another list you'll ignore.</p>
			</div>
		</div>
	</section>

	<!-- ===== TOOLS ===== -->
	<section class="tools" id="tools">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Free tools</p>
				<h2>Tools for when your brain feels full</h2>
			</div>
			<div class="tools-grid">
				{tools.map((t) => (
					<a class={`tool-card c-${t.color}`} href={t.href}>
						<div class="tool-surface">
							<span class="tool-tag">{t.tag}</span>
							<h3>{t.name}</h3>
							<p>{t.desc}</p>
							<span class="tool-link">Try it free <span class="arrow">→</span></span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== PATHS ===== -->
	<section class="paths">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Choose your path</p>
				<h2>Start with a problem</h2>
			</div>
			<div class="paths-grid">
				{pillars.map((p) => (
					<a class={`path-card c-${p.color}`} href={p.href}>
						<span class="path-num">{p.num}</span>
						<h3>{p.title}</h3>
						<p>{p.desc}</p>
						<span class="path-link">Explore <span class="arrow">→</span></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== ETSY / PRINTABLES ===== -->
	<section class="printables">
		<div class="container">
			<div class="printables-inner">
				<svg class="leaf-accent leaf-printables" viewBox="0 0 100 100" aria-hidden="true"><g fill="#fff"><ellipse cx="50" cy="30" rx="7" ry="17" transform="rotate(20 50 30)"/><ellipse cx="65" cy="45" rx="6" ry="14" transform="rotate(55 65 45)"/><ellipse cx="35" cy="45" rx="6" ry="14" transform="rotate(-30 35 45)"/></g></svg>
				<div class="printables-copy">
					<p class="eyebrow">Printables</p>
					<h2>Take the system off-screen.</h2>
					<p class="section-lede">Prefer paper? The same planning systems are available as printable planners — instant download, designed to reuse.</p>
					<a class="btn btn-on-color" href={etsyLink({ medium: "homepage", campaign: "homepage" })} target="_blank" rel="sponsored noopener" data-analytics-event="etsy_click">Browse printable planners →</a>
				</div>
				<div class="printables-visual">
					<div class="planner">
						<div class="planner-page page-back"></div>
						<div class="planner-page page-mid"></div>
						<div class="planner-page page-front">
							<span class="planner-line"></span>
							<span class="planner-line"></span>
							<span class="planner-line short"></span>
						</div>
						<div class="planner-spine"></div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	// ---- Hero: persistent floating task cards (no WebGL, pure CSS/DOM) ----
	const stage = document.getElementById('stage');
	const field = document.getElementById('field');
	if (stage && field) {
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!prefersReduced && window.matchMedia('(pointer: fine)').matches) {
			stage.addEventListener('mousemove', (e) => {
				const rect = stage.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width - 0.5;
				const y = (e.clientY - rect.top) / rect.height - 0.5;
				field.style.transform = `rotateY(${(x * 8).toFixed(1)}deg) rotateX(${(-y * 8).toFixed(1)}deg)`;
			});
			stage.addEventListener('mouseleave', () => {
				field.style.transform = 'rotateY(0deg) rotateX(0deg)';
			});
		}
	}

	// ---- Scroll reveal ----
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('revealed');
				revealObserver.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.story, .sorting, .clarity, .tools, .paths, .printables').forEach((el) => {
		revealObserver.observe(el);
	});
</script>

<style>
	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.eyebrow {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--primary);
		margin: 0 0 1rem;
	}

	.section-lede {
		font-size: 1.15rem;
		color: var(--ink-soft);
		line-height: 1.6;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.85rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 1rem;
		transition: all var(--duration-fast) ease;
		cursor: pointer;
		text-decoration: none;
	}
	.btn-primary {
		background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 55%), var(--primary);
		color: #fff;
		border: none;
		box-shadow: 0 10px 24px rgba(74, 107, 90, 0.35);
	}
	.btn-primary:hover {
		background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 55%), var(--primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px rgba(74, 107, 90, 0.42);
	}
	.btn-secondary {
		background: #fff;
		color: var(--primary-dark);
		border: none;
		box-shadow: 0 8px 20px rgba(28, 29, 31, 0.10);
	}
	.btn-secondary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px rgba(28, 29, 31, 0.14);
	}
	.btn-on-color {
		background: #fff;
		color: var(--primary-dark);
		border: none;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
	}
	.btn-on-color:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.24);
	}

	/* ===== HERO ===== */
	.hero {
		max-width: 1280px;
		margin: 0 auto;
		padding: 3rem 32px 5rem;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 3rem;
		align-items: center;
		min-height: 88vh;
	}
	.hero-copy h1 {
		font-size: clamp(2.75rem, 5.5vw, 4.25rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
	}
	.hero-lede {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 460px;
		margin-bottom: 2rem;
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	.hero-trust {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--ink-muted);
	}

	/* Persistent floating task-card hero visual */
	.hero-stage {
		position: relative;
		height: 560px;
		perspective: 1400px;
	}
	.leaf-accent {
		position: absolute;
		pointer-events: none;
		z-index: 0;
	}
	.leaf-hero { top: -10px; right: -10px; width: 120px; height: 120px; opacity: 0.85; }
	.leaf-sorting { bottom: -20px; left: -20px; width: 140px; height: 100px; opacity: 0.6; }
	.leaf-printables { top: 10px; right: 20px; width: 90px; height: 90px; opacity: 0.35; }
	.stage-field {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transition: transform 0.4s ease-out;
	}
	.task-card {
		position: absolute;
		top: var(--y);
		left: var(--x);
		transform: translateZ(var(--z)) rotate(var(--r));
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1.1rem;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(10px);
		box-shadow: 0 20px 40px rgba(28, 29, 31, 0.12);
		font-weight: 600;
		font-size: 0.92rem;
		color: var(--ink);
		animation: cardFloat 7s ease-in-out infinite;
		animation-delay: calc(var(--z) * -0.02s);
	}
	.task-card.small { padding: 0.7rem 0.9rem; font-size: 0.8rem; }
	.task-card .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 0.4rem; }
	.task-card small { font-weight: 500; font-size: 0.72rem; opacity: 0.7; }
	.task-card.zone-now { border-left: 4px solid #4A6B5A; }
	.task-card.zone-now .dot { background: #4A6B5A; }
	.task-card.zone-deadline { border-left: 4px solid #D98E3F; }
	.task-card.zone-deadline .dot { background: #D98E3F; }
	.task-card.zone-later { border-left: 4px solid #7F77DD; }
	.task-card.zone-later .dot { background: #7F77DD; }
	@keyframes cardFloat {
		0%, 100% { transform: translateZ(var(--z)) rotate(var(--r)) translateY(0); }
		50% { transform: translateZ(var(--z)) rotate(var(--r)) translateY(-14px); }
	}
	.stage-legend {
		position: absolute;
		bottom: 0;
		left: 0;
		display: flex;
		gap: 0.6rem;
	}
	.legend-item {
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #fff;
	}
	.legend-item.zone-now { background: #4A6B5A; }
	.legend-item.zone-deadline { background: #D98E3F; }
	.legend-item.zone-later { background: #7F77DD; }
	@media (prefers-reduced-motion: reduce) {
		.task-card { animation: none; }
	}

	/* ===== SCROLL STORY ===== */
	.story, .sorting, .clarity, .tools, .paths, .printables {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
	}
	.story.revealed, .sorting.revealed, .clarity.revealed, .tools.revealed, .paths.revealed, .printables.revealed {
		opacity: 1;
		transform: translateY(0);
	}

	/* CHAOS */
	.story {
		padding: 5rem 0;
		background: var(--bg-warm);
	}
	.story-head {
		max-width: 640px;
		margin-bottom: 3rem;
	}
	.story-head h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.chaos-scene {
		position: relative;
		min-height: 220px;
	}
	.chaos-chip {
		position: absolute;
		padding: 0.75rem 1.25rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 14px;
		font-size: 0.9rem;
		box-shadow: 0 8px 24px rgba(28, 29, 31, 0.08);
	}
	.c1 { top: 0; left: 5%; transform: rotate(-5deg); }
	.c2 { top: 20px; left: 40%; transform: rotate(3deg); }
	.c3 { top: 0; left: 70%; transform: rotate(-2deg); }
	.c4 { top: 80px; left: 15%; transform: rotate(4deg); }
	.c5 { top: 100px; left: 55%; transform: rotate(-4deg); }
	.c6 { top: 140px; left: 30%; transform: rotate(2deg); }
	.c7 { top: 60px; left: 85%; transform: rotate(-3deg); }
	.c8 { top: 160px; left: 70%; transform: rotate(5deg); }

	/* SORTING */
	.sorting {
		padding: 5rem 0;
	}
	.sorting-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.sorting-copy h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.sorting-flow {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.flow-in {
		flex: 1;
		background: var(--bg-warm);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		text-align: center;
		font-weight: 600;
		color: var(--ink-soft);
	}
	.flow-arrow {
		font-size: 1.5rem;
		color: var(--primary);
	}
	.flow-out {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.flow-out div {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1rem;
		text-align: center;
	}
	.flow-out strong {
		color: var(--primary);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* CLARITY */
	.clarity {
		padding: 5rem 0;
		background: var(--primary-light);
		text-align: center;
	}
	.clarity-inner {
		max-width: 640px;
		margin: 0 auto;
	}
	.clarity h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	/* ===== TOOLS ===== */
	.tools {
		padding: 5rem 0;
	}
	.section-head {
		max-width: 640px;
		margin-bottom: 3rem;
	}
	.section-head h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.tool-card {
		text-decoration: none;
		color: var(--ink);
		display: block;
		perspective: 800px;
	}
	.tool-surface {
		position: relative;
		padding: 2.5rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: 0 16px 40px rgba(28, 29, 31, 0.08);
		transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
		transform-style: preserve-3d;
	}
	.tool-card:hover .tool-surface {
		transform: translateY(-6px) rotateX(2deg);
		box-shadow: 0 24px 60px rgba(28, 29, 31, 0.12);
	}
	.tool-tag {
		display: inline-block;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		color: #fff;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		margin-bottom: 1.25rem;
	}
	.tool-card.c-purple .tool-surface { background: #EEEDFE; }
	.tool-card.c-purple .tool-tag { background: #7F77DD; }
	.tool-card.c-purple h3 { color: #26215C; }
	.tool-card.c-purple .tool-link { color: #534AB7; }
	.tool-card.c-green .tool-surface { background: #EAF3DE; }
	.tool-card.c-green .tool-tag { background: #639922; }
	.tool-card.c-green h3 { color: #173404; }
	.tool-card.c-green .tool-link { color: #3B6D11; }
	.tool-card.c-amber .tool-surface { background: #FAEEDA; }
	.tool-card.c-amber .tool-tag { background: #BA7517; }
	.tool-card.c-amber h3 { color: #412402; }
	.tool-card.c-amber .tool-link { color: #854F0B; }
	.tool-surface h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.tool-surface p {
		color: var(--ink-soft);
		font-size: 1rem;
		margin-bottom: 1.5rem;
	}
	.tool-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		font-size: 0.95rem;
	}
	.arrow {
		transition: transform var(--duration-fast) ease;
	}
	.tool-card:hover .arrow,
	.path-card:hover .arrow {
