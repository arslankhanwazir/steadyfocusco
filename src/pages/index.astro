---
import Base from '../layouts/Base.astro';
import { etsyLink } from '../data/site';

const tools = [
	{ name: "Brain Dump", desc: "Clear the noise.", href: "/tools/brain-dump", tag: "ADHD" },
	{ name: "Weekly Reset", desc: "Turn a scattered week into a clear plan.", href: "/tools/weekly-reset", tag: "Productivity" },
	{ name: "Morning Routine", desc: "Build a routine you'll actually use.", href: "/tools/morning-routine", tag: "ADHD" },
];

const pillars = [
	{ num: "01", title: "ADHD", desc: "Planning, routines, and systems built around how an ADHD brain actually works.", href: "/adhd" },
	{ num: "02", title: "Students", desc: "Homework, study planning, and getting assignments done without the spiral.", href: "/students" },
	{ num: "03", title: "Productivity", desc: "Weekly planning, prioritizing, and routines that don't require willpower.", href: "/productivity" },
];
---
<Base title="Planning for overwhelmed minds">
	<!-- ===== HERO ===== -->
	<section class="hero" id="hero">
		<div class="hero-copy">
			<p class="eyebrow">Planning for overwhelmed minds</p>
			<h1>Make planning easier when your brain feels overwhelmed.</h1>
			<p class="hero-lede">Free tools and practical systems that turn scattered thoughts into clear next steps.</p>
			<div class="hero-actions">
				<a href="/tools/brain-dump" class="btn btn-primary">Try a free tool</a>
				<a href="#story" class="btn btn-secondary">Explore resources</a>
			</div>
			<div class="hero-trust">
				<span>Free</span><span>·</span><span>No sign-up</span><span>·</span><span>Private</span>
			</div>
		</div>

		<!-- Persistent 3D thought-cloud visual (Three.js) -->
		<div class="hero-stage" id="hero3d" aria-label="Interactive 3D thought sorting demonstration"></div>
	</section>

	<!-- ===== SCROLL STORY: CHAOS ===== -->
	<section class="story" id="story">
		<div class="container">
			<div class="story-head">
				<p class="eyebrow">The problem</p>
				<h2>Your brain isn't a checklist.</h2>
				<p class="section-lede">Scattered thoughts pile up until everything feels urgent. The fix isn't more willpower — it's getting it out of your head and into a system.</p>
			</div>
			<div class="chaos-scene">
				<div class="chaos-chip c1">Buy groceries</div>
				<div class="chaos-chip c2">Reply to email</div>
				<div class="chaos-chip c3">Study for exam</div>
				<div class="chaos-chip c4">Doctor appointment</div>
				<div class="chaos-chip c5">Finish assignment</div>
				<div class="chaos-chip c6">Laundry</div>
				<div class="chaos-chip c7">Project</div>
				<div class="chaos-chip c8">Meeting</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: SORTING ===== -->
	<section class="sorting">
		<div class="container">
			<div class="sorting-inner">
				<div class="sorting-copy">
					<p class="eyebrow">The method</p>
					<h2>Sort it once. See the next step.</h2>
					<p class="section-lede">Everything lands in one of three places — do it now, it has a deadline, or it can wait. That's the whole system.</p>
				</div>
				<div class="sorting-visual">
					<div class="sorting-flow">
						<div class="flow-in"><span>Scattered</span></div>
						<div class="flow-arrow">→</div>
						<div class="flow-out">
							<div><strong>Now</strong></div>
							<div><strong>Deadline</strong></div>
							<div><strong>Later</strong></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ===== SCROLL STORY: CLARITY ===== -->
	<section class="clarity">
		<div class="container">
			<div class="clarity-inner">
				<p class="eyebrow">The result</p>
				<h2>Clear the noise. Find the next step.</h2>
				<p class="section-lede">A calm, organized plan you can actually start — not another list you'll ignore.</p>
			</div>
		</div>
	</section>

	<!-- ===== TOOLS ===== -->
	<section class="tools" id="tools">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Free tools</p>
				<h2>Tools for when your brain feels full</h2>
			</div>
			<div class="tools-grid">
				{tools.map((t) => (
					<a class="tool-card" href={t.href}>
						<div class="tool-surface">
							<span class="tool-tag">{t.tag}</span>
							<h3>{t.name}</h3>
							<p>{t.desc}</p>
							<span class="tool-link">Try it free <span class="arrow">→</span></span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== PATHS ===== -->
	<section class="paths">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Choose your path</p>
				<h2>Start with a problem</h2>
			</div>
			<div class="paths-grid">
				{pillars.map((p) => (
					<a class="path-card" href={p.href}>
						<span class="path-num">{p.num}</span>
						<h3>{p.title}</h3>
						<p>{p.desc}</p>
						<span class="path-link">Explore <span class="arrow">→</span></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ===== ETSY / PRINTABLES ===== -->
	<section class="printables">
		<div class="container">
			<div class="printables-inner">
				<div class="printables-copy">
					<p class="eyebrow">Printables</p>
					<h2>Take the system off-screen.</h2>
					<p class="section-lede">Prefer paper? The same planning systems are available as printable planners — instant download, designed to reuse.</p>
					<a class="btn btn-primary" href={etsyLink({ medium: "homepage", campaign: "homepage" })} target="_blank" rel="sponsored noopener" data-analytics-event="etsy_click">Browse printable planners →</a>
				</div>
				<div class="printables-visual">
					<div class="planner">
						<div class="planner-page page-back"></div>
						<div class="planner-page page-mid"></div>
						<div class="planner-page page-front">
							<span class="planner-line"></span>
							<span class="planner-line"></span>
							<span class="planner-line short"></span>
						</div>
						<div class="planner-spine"></div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	import { initHero3D } from '../components/Hero3D';

	// ---- Persistent 3D hero visual ----
	const container = document.getElementById('hero3d');
	if (container) {
		initHero3D({ container });
	}

	// ---- Scroll reveal ----
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('revealed');
				revealObserver.unobserve(entry.target);
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.story, .sorting, .clarity, .tools, .paths, .printables').forEach((el) => {
		revealObserver.observe(el);
	});
</script>

<style>
	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.eyebrow {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--primary);
		margin: 0 0 1rem;
	}

	.section-lede {
		font-size: 1.15rem;
		color: var(--ink-soft);
		line-height: 1.6;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 1.75rem;
		border-radius: 10px;
		font-weight: 600;
		font-size: 1rem;
		transition: all var(--duration-fast) ease;
		cursor: pointer;
		text-decoration: none;
	}
	.btn-primary {
		background: var(--primary);
		color: #fff;
		border: 1px solid var(--primary);
	}
	.btn-primary:hover {
		background: var(--primary-dark);
		border-color: var(--primary-dark);
		transform: translateY(-2px);
	}
	.btn-secondary {
		background: transparent;
		color: var(--ink);
		border: 1.5px solid var(--border);
	}
	.btn-secondary:hover {
		border-color: var(--primary);
		color: var(--primary);
		transform: translateY(-2px);
	}

	/* ===== HERO ===== */
	.hero {
		max-width: 1280px;
		margin: 0 auto;
		padding: 3rem 32px 5rem;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 3rem;
		align-items: center;
		min-height: 88vh;
	}
	.hero-copy h1 {
		font-size: clamp(2.75rem, 5.5vw, 4.25rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
	}
	.hero-lede {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 460px;
		margin-bottom: 2rem;
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	.hero-trust {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--ink-muted);
	}

	/* Immersive 3D stage */
	.hero-stage {
		position: relative;
		height: 560px;
		border-radius: 32px;
		overflow: hidden;
	}
	.hero-stage canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* ===== SCROLL STORY ===== */
	.story, .sorting, .clarity, .tools, .paths, .printables {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
	}
	.story.revealed, .sorting.revealed, .clarity.revealed, .tools.revealed, .paths.revealed, .printables.revealed {
		opacity: 1;
		transform: translateY(0);
	}

	/* CHAOS */
	.story {
		padding: 5rem 0;
		background: var(--bg-warm);
	}
	.story-head {
		max-width: 640px;
		margin-bottom: 3rem;
	}
	.story-head h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.chaos-scene {
		position: relative;
		min-height: 220px;
	}
	.chaos-chip {
		position: absolute;
		padding: 0.75rem 1.25rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 14px;
		font-size: 0.9rem;
		box-shadow: 0 8px 24px rgba(28, 29, 31, 0.08);
	}
	.c1 { top: 0; left: 5%; transform: rotate(-5deg); }
	.c2 { top: 20px; left: 40%; transform: rotate(3deg); }
	.c3 { top: 0; left: 70%; transform: rotate(-2deg); }
	.c4 { top: 80px; left: 15%; transform: rotate(4deg); }
	.c5 { top: 100px; left: 55%; transform: rotate(-4deg); }
	.c6 { top: 140px; left: 30%; transform: rotate(2deg); }
	.c7 { top: 60px; left: 85%; transform: rotate(-3deg); }
	.c8 { top: 160px; left: 70%; transform: rotate(5deg); }

	/* SORTING */
	.sorting {
		padding: 5rem 0;
	}
	.sorting-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.sorting-copy h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}
	.sorting-flow {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.flow-in {
		flex: 1;
		background: var(--bg-warm);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		text-align: center;
		font-weight: 600;
		color: var(--ink-soft);
	}
	.flow-arrow {
		font-size: 1.5rem;
		color: var(--primary);
	}
	.flow-out {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.flow-out div {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1rem;
		text-align: center;
	}
	.flow-out strong {
		color: var(--primary);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* CLARITY */
	.clarity {
		padding: 5rem 0;
		background: var(--primary-light);
		text-align: center;
	}
	.clarity-inner {
		max-width: 640px;
		margin: 0 auto;
	}
	.clarity h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	/* ===== TOOLS ===== */
	.tools {
		padding: 5rem 0;
	}
	.section-head {
		max-width: 640px;
		margin-bottom: 3rem;
	}
	.section-head h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.tools-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.tool-card {
		text-decoration: none;
		color: var(--ink);
		display: block;
		perspective: 800px;
	}
	.tool-surface {
		position: relative;
		padding: 2.5rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 20px;
		box-shadow: 0 16px 40px rgba(28, 29, 31, 0.08);
		transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
		transform-style: preserve-3d;
	}
	.tool-card:hover .tool-surface {
		transform: translateY(-6px) rotateX(2deg);
		box-shadow: 0 24px 60px rgba(28, 29, 31, 0.12);
	}
	.tool-tag {
		display: inline-block;
		padding: 0.3rem 0.7rem;
		background: var(--primary-light);
		color: var(--primary-dark);
		border-radius: 6px;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		margin-bottom: 1.25rem;
	}
	.tool-surface h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.tool-surface p {
		color: var(--ink-soft);
		font-size: 1rem;
		margin-bottom: 1.5rem;
	}
	.tool-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--primary);
		font-weight: 600;
		font-size: 0.95rem;
	}
	.arrow {
		transition: transform var(--duration-fast) ease;
	}
	.tool-card:hover .arrow,
	.path-card:hover .arrow {
		transform: translateX(4px);
	}

	/* ===== PATHS ===== */
	.paths {
		padding: 5rem 0;
		background: var(--bg-warm);
	}
	.paths-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.path-card {
		padding: 2.5rem;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 20px;
		text-decoration: none;
		color: var(--ink);
		display: block;
		transition: all var(--duration-normal) var(--ease-out);
	}
	.path-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 24px 60px rgba(28, 29, 31, 0.12);
	}
	.path-num {
		display: block;
		font-family: var(--display);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--primary);
		margin-bottom: 1.5rem;
	}
	.path-card h3 {
		font-size: 1.75rem;
		margin-bottom: 0.75rem;
	}
	.path-card p {
		color: var(--ink-soft);
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}
	.path-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--primary);
		font-weight: 600;
		font-size: 0.95rem;
	}

	/* ===== PRINTABLES ===== */
	.printables {
		padding: 5rem 0;
	}
	.printables-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 24px;
		padding: 3.5rem;
		box-shadow: 0 24px 60px rgba(28, 29, 31, 0.06);
	}
	.printables-copy h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 1rem;
	}
	.printables-copy .section-lede {
		margin-bottom: 2rem;
	}
	.printables-visual {
		display: flex;
		align-items: center;
		justify-content: center;
		perspective: 1000px;
	}
	.planner {
		position: relative;
		width: 240px;
		height: 320px;
		transform-style: preserve-3d;
		transform: rotateY(-12deg) rotateX(4deg);
	}
	.planner-page {
		position: absolute;
		inset: 0;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 6px;
		box-shadow: 0 12px 32px rgba(28, 29, 31, 0.12);
	}
	.page-back { transform: translateZ(-12px) translateX(6px); }
	.page-mid { transform: translateZ(-6px) translateX(3px); }
	.page-front {
		transform: translateZ(0);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.planner-line {
		display: block;
		height: 8px;
		background: var(--bg-warm);
		border-radius: 4px;
	}
	.planner-line.short { width: 60%; }
	.planner-spine {
		position: absolute;
		left: -6px;
		top: 0;
		bottom: 0;
		width: 12px;
		background: var(--primary);
		border-radius: 3px 0 0 3px;
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 1024px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 3rem 24px 4rem;
			min-height: auto;
		}
		.hero-stage {
			height: 480px;
		}
		.tools-grid, .paths-grid {
			grid-template-columns: 1fr 1fr;
		}
		.sorting-inner, .printables-inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 768px) {
		.container {
			padding: 0 20px;
		}
		.hero {
			padding: 2.5rem 20px 3.5rem;
		}
		.hero-actions {
			flex-direction: column;
		}
		.btn {
			width: 100%;
		}
		.tools-grid, .paths-grid {
			grid-template-columns: 1fr;
		}
		.hero-stage {
			height: 420px;
		}
		.chaos-scene {
			min-height: 300px;
		}
		.sorting-flow {
			flex-direction: column;
		}
		.flow-arrow {
			transform: rotate(90deg);
		}
	}

	@media (max-width: 480px) {
		.hero-copy h1 {
			font-size: 2.25rem;
		}
		.hero-lede {
			font-size: 1.1rem;
		}
		.printables-inner {
			padding: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.story, .sorting, .clarity, .tools, .paths, .printables {
			opacity: 1;
			transform: none;
			transition: none;
		}
		.hero-stage {
			perspective: none;
		}
		.tool-card:hover .tool-surface,
		.path-card:hover {
			transform: none;
		}
	}
</style>