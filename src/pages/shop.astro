---
import Base from "../layouts/Base.astro";
import { etsyLink, ETSY_SHOP_URL } from "../data/site";
import productData from "../data/products.json";

interface Product {
  listing_id: number | null;
  title: string;
  price: string | null;
  currency_code: string;
  image: string | null;
  url: string;
  cluster?: string;
}

const products = (productData.products ?? []) as Product[];
const isSeed = productData.source === "seed";

function displayPrice(p: Product): string {
  if (!p.price) return "";
  return p.currency_code === "USD"
    ? `$${p.price}`
    : `${p.price} ${p.currency_code}`;
}

// Buy link: real listing URL when known, UTM-tagged per spec
// (utm_source=site&utm_medium=shop). Falls back to the shop landing page.
function buyHref(p: Product): string {
  return etsyLink({
    medium: "shop",
    campaign: "shop",
    url: p.url || ETSY_SHOP_URL,
  });
}
---

<Base
  title="Shop"
  description="Browse SteadyFocusCo's ADHD and student planning printables. Every purchase happens securely on Etsy — this page just shows what's in the shop."
>
  <section class="shop-hero">
    <p class="eyebrow">The shop</p>
    <h1>Printable planners & systems</h1>
    <p class="lede">
      Reusable, instant-download PDFs that turn the free tools on this site into
      something you can print and keep. Every purchase happens on Etsy — tap a
      product and you'll land straight on its Etsy listing to check out.
    </p>
  </section>

  <section class="shop-grid-wrap">
    <div class="shop-grid">
      {
        products.map((p) => (
          <article class="product">
            <a
              class="thumb"
              href={buyHref(p)}
              target="_blank"
              rel="sponsored noopener"
              aria-label={`View ${p.title} on Etsy`}
            >
              {p.image ? (
                <img src={p.image} alt={p.title} loading="lazy" />
              ) : (
                <span class="thumb-placeholder">
                  <span>SteadyFocusCo</span>
                  <small>Photo on Etsy ↗</small>
                </span>
              )}
            </a>
            <div class="product-body">
              <h2>{p.title}</h2>
              <div class="meta">
                {p.price && <span class="price">{displayPrice(p)}</span>}
                {p.cluster && <span class="tag">{p.cluster}</span>}
              </div>
              <a
                class="buy"
                href={buyHref(p)}
                target="_blank"
                rel="sponsored noopener"
              >
                Buy on Etsy ↗
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {
      isSeed && (
        <p class="seed-note">
          Showing the current shop listing set. Product photos and direct
          listing links appear automatically after the Etsy API sync runs at
          build time (see <code>scripts/sync-etsy-products.js</code>).
        </p>
      )
    }

    <p class="policy">
      SteadyFocusCo never processes payments on this site. Every “Buy” button
      opens the real Etsy listing, where checkout is handled by Etsy.
    </p>
  </section>
</Base>

<style>
  .shop-hero {
    max-width: 760px;
    margin: 3rem auto 2.5rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.4rem;
  }
  .shop-hero h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.6rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .shop-grid-wrap {
    max-width: 1100px;
    margin: 0 auto 4rem;
    padding: 0 1.5rem;
  }
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .product {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .thumb {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--bg);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, #eef0ea, #e3e8e0);
    color: var(--primary-dark);
    font-family: var(--display);
    font-size: 1.05rem;
  }
  .thumb-placeholder small {
    font-family: var(--body);
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  .product-body {
    padding: 1.1rem 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .product-body h2 {
    font-size: 1.02rem;
    line-height: 1.3;
    margin: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .price {
    font-weight: 700;
    color: var(--ink);
  }
  .tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background: #eef0ea;
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
    font-weight: 700;
  }
  .buy {
    margin-top: auto;
    display: inline-block;
    text-align: center;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    padding: 0.65rem 1rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .buy:hover {
    background: var(--primary-dark);
  }

  .seed-note,
  .policy {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin-top: 2rem;
    text-align: center;
  }
  .policy {
    margin-top: 0.75rem;
  }

  @media (max-width: 800px) {
    .shop-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .shop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
