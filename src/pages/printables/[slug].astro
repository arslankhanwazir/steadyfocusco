import Base from "../../layouts/Base.astro";
import {
  printables,
  toolBySlug,
  etsyLink,
  type Printable,
} from "../../data/site";
import { productSchema } from "../../data/schema";

export function getStaticPaths() {
  return printables.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const printable = printables.find((p) => p.slug === slug) as Printable;
const tool = printable.relatedTool ? toolBySlug(printable.relatedTool) : null;
const shopHref = etsyLink({
  medium: "printable",
  campaign: printable.slug,
});

const siteBase = new URL("/", Astro.site).toString().replace(/\/$/, "");

const productData: Parameters<typeof productSchema>[1] = {
  name: printable.title,
  description: printable.description,
  path: `/printables/${printable.slug}`,
  image: printable.image ?? null,
  offerUrl: shopHref,
  price: printable.price ?? null,
  currency: printable.currency ?? null,
};

const productSchemaData = productSchema(siteBase, productData);

<Base
  title={printable.title}
  description={printable.description}
  schema={[productSchemaData]}
>
  <article class="printable">
    <p class="eyebrow no-print">Free printable</p>
    <h1>{printable.title}</h1>
    <p class="lede">{printable.description}</p>

    <div class="actions no-print">
      <button class="btn-print" onclick="window.print()">
        ↓ Print / Save as PDF
      </button>
      {
        tool && (
          <a class="btn-tool" href={`/tools/${tool.slug}`}>
            Prefer to type it? Use the {tool.name} tool →
          </a>
        )
      }
    </div>
  </article>
</Base>