---
import Base from "../../layouts/Base.astro";
import {
  printables,
  toolBySlug,
  etsyLink,
  type Printable,
} from "../../data/site";

export function getStaticPaths() {
  return printables.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const printable = printables.find((p) => p.slug === slug) as Printable;
const tool = printable.relatedTool ? toolBySlug(printable.relatedTool) : null;
const shopHref = etsyLink({
  medium: "printable",
  campaign: printable.slug,
});
---

<Base title={printable.title} description={printable.description}>
  <article class="printable">
    <p class="eyebrow no-print">Free printable</p>
    <h1>{printable.title}</h1>
    <p class="lede">{printable.description}</p>

    <div class="actions no-print">
      <button class="btn-print" onclick="window.print()">
        ↓ Print / Save as PDF
      </button>
      {
        tool && (
          <a class="btn-tool" href={`/tools/${tool.slug}`}>
            Prefer to type it? Use the {tool.name} tool →
          </a>
        )
      }
    </div>

    <!-- The printable sheet itself. Kept intentionally simple so it prints
         cleanly on one page in black and white. -->
    <div class="sheet">
      <header class="sheet-head">
        <span class="sheet-brand">SteadyFocusCo</span>
        <span class="sheet-title">{printable.title}</span>
        <span class="sheet-date">Date: ____________________</span>
      </header>

      {
        printable.slug === "adhd-brain-dump" && (
          <div class="sheet-body">
            <p class="sheet-prompt">
              What's taking up space in your head? Write it all down first — then
              tick which box each one belongs in.
            </p>
            <div class="brain-lines">
              {Array.from({ length: 12 }).map(() => (
                <div class="line">
                  <span class="dots" />
                  <span class="boxes">
                    <em>Now</em> <em>Deadline</em> <em>Quick</em> <em>Later</em>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        printable.slug === "weekly-reset-sheet" && (
          <div class="sheet-body">
            <div class="top3">
              <strong>This week's top 3</strong>
              <ol>
                <li>______________________________</li>
                <li>______________________________</li>
                <li>______________________________</li>
              </ol>
            </div>
            <div class="week">
              {[
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Weekend",
              ].map((d) => (
                <div class="week-day">
                  <strong>{d}</strong>
                  <span class="wl" />
                  <span class="wl" />
                  <span class="wl" />
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        printable.slug === "homework-checklist" && (
          <div class="sheet-body">
            <p class="sheet-prompt">
              Assignment: ______________________________ Due: ____________
            </p>
            <p class="sheet-prompt">
              Break it into the smallest steps you can. Tick each as you go.
            </p>
            <ul class="checks">
              {Array.from({ length: 10 }).map(() => (
                <li>
                  <span class="box" /> <span class="dots" />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        printable.slug === "morning-checklist" && (
          <div class="sheet-body">
            <p class="sheet-prompt">
              Wake-up time: __________ &nbsp; Out-the-door time: __________
            </p>
            <ul class="checks">
              {Array.from({ length: 10 }).map(() => (
                <li>
                  <span class="box" /> <span class="time">______</span>{" "}
                  <span class="dots" />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <footer class="sheet-foot">steadyfocusco.com · free printable</footer>
    </div>

    <section class="printable-cta no-print">
      <h2>Want the polished, reusable version?</h2>
      <p>
        This free sheet has a matching, nicely designed planner in the shop —
        the {printable.relatedProduct}. Instant download on Etsy.
      </p>
      <a href={shopHref} target="_blank" rel="sponsored noopener" data-analytics-event="etsy_click">
        Get {printable.relatedProduct} on Etsy ↗
      </a>
    </section>
  </article>
</Base>

<style>
  .printable {
    max-width: 820px;
    margin: 2.5rem auto 4rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin-bottom: 0.5rem;
  }
  .lede {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .btn-print {
    background: var(--primary);
    color: #fff;
    border: none;
    font-family: var(--body);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.7rem 1.3rem;
    border-radius: 100px;
    cursor: pointer;
  }
  .btn-print:hover {
    background: var(--primary-dark);
  }
  .btn-tool {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .sheet {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    color: #000;
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 2px solid #000;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .sheet-brand {
    font-family: var(--display);
    font-weight: 600;
  }
  .sheet-title {
    font-weight: 700;
  }
  .sheet-date {
    color: #444;
    font-size: 0.9rem;
  }
  .sheet-prompt {
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  .brain-lines .line,
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .dots {
    flex: 1;
    border-bottom: 1px dotted #666;
    height: 1.1rem;
  }
  .boxes {
    display: flex;
    gap: 0.4rem;
  }
  .boxes em {
    font-style: normal;
    font-size: 0.7rem;
    border: 1px solid #333;
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    color: #333;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .box {
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid #000;
    border-radius: 3px;
    flex: none;
  }
  .time {
    font-size: 0.85rem;
    color: #444;
    min-width: 3.5rem;
  }
  .top3 {
    margin-bottom: 1.25rem;
  }
  .top3 ol {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
  .top3 li {
    margin-bottom: 0.5rem;
  }
  .week {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .week-day {
    border: 1px solid #000;
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
  }
  .week-day strong {
    display: block;
    margin-bottom: 0.4rem;
  }
  .wl {
    display: block;
    border-bottom: 1px dotted #666;
    height: 1.05rem;
    margin-bottom: 0.35rem;
  }
  .sheet-foot {
    margin-top: 1.5rem;
    text-align: center;
    color: #666;
    font-size: 0.8rem;
  }

  .printable-cta {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    text-align: center;
    margin-top: 2.5rem;
  }
  .printable-cta h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .printable-cta p {
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
  }
  .printable-cta a {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    padding: 0.8rem 1.75rem;
    border-radius: 100px;
    font-weight: 700;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .printable {
      margin: 0;
      max-width: none;
      padding: 0;
    }
    .sheet {
      border: none;
      border-radius: 0;
      padding: 0;
    }
    :global(.site-header),
    :global(.site-footer) {
      display: none !important;
    }
  }
</style>
