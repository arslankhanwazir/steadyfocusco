---
import Base from "../../layouts/Base.astro";
import { printables } from "../../data/site";
---

<Base
  title="Free printables"
  description="Free, printable planning sheets for overwhelmed minds — brain dump, weekly reset, homework checklist, and morning routine. Print or save as PDF, no sign-up."
>
  <section class="printables">
    <p class="eyebrow">Free printables</p>
    <h1>Print it, fill it in, feel a bit lighter</h1>
    <p class="lede">
      Clean, one-page sheets you can print at home or save as a PDF. No email
      wall, no sign-up — the paper versions of the tools on this site.
    </p>

    <div class="grid">
      {
        printables.map((p) => (
          <a class="card" href={`/printables/${p.slug}`}>
            <h2>{p.title}</h2>
            <p>{p.description}</p>
            <span class="get">Open & print →</span>
          </a>
        ))
      }
    </div>

    <p class="note">
      More printables get added here as they're built. Want a fancier, reusable
      version? Each sheet has a matching planner in the
      <a href="/shop">shop</a>.
    </p>
  </section>
</Base>

<style>
  .printables {
    max-width: 1100px;
    margin: 3rem auto 4rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.4rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.6rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 620px;
    margin: 0 0 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    transition:
      box-shadow 0.15s,
      transform 0.15s;
  }
  .card:hover {
    box-shadow: 0 8px 24px rgba(43, 46, 40, 0.08);
    transform: translateY(-3px);
  }
  .card h2 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0 0 1rem;
  }
  .get {
    color: var(--primary);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .note {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
