# SteadyFocusCo — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# The Etsy sync is READ-ONLY and only displays our own shop's ACTIVE listings.
# It never processes payments — all purchase links go to Etsy itself.

# Your Etsy app's keystring (Developer portal -> your app -> "Keystring").
# Used as the OAuth client_id. NOTE: Etsy now requires the Shared Secret in
# the `x-api-key` header for API calls, so the sync script must send the
# Shared Secret (not the keystring) as x-api-key.
ETSY_API_KEY=

# Your Etsy app's Shared Secret (Developer portal -> your app -> "Shared secret").
# Etsy requires this in the `x-api-key` header for API v3 calls.
ETSY_SHARED_SECRET=

# Preferred: the numeric shop id. If you don't know it, set ETSY_SHOP_NAME
# instead and the sync script will resolve the id for you.
ETSY_SHOP_ID=

# Shop name fallback (used only if ETSY_SHOP_ID is empty).
ETSY_SHOP_NAME=steadyfocusco

# OAuth2 access token, obtained via `node scripts/etsy-oauth.mjs`.
# Sent as `Authorization: Bearer <token>`.
ETSY_ACCESS_TOKEN=

# OAuth2 refresh token, obtained via `node scripts/etsy-oauth.mjs`.
# Used to refresh the access token when it expires.
ETSY_REFRESH_TOKEN=

# Optional: canonical production URL (used for sitemap + Open Graph).
# Defaults to https://steadyfocusco.com if unset.
SITE_URL=
