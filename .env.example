# SteadyFocusCo — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# The Etsy sync is READ-ONLY and only displays our own shop's ACTIVE listings.
# It never processes payments — all purchase links go to Etsy itself.

# Your Etsy app's keystring (Developer portal -> your app -> "Keystring").
# Sent as the `x-api-key` header.
ETSY_API_KEY=

# Preferred: the numeric shop id. If you don't know it, set ETSY_SHOP_NAME
# instead and the sync script will resolve the id for you.
ETSY_SHOP_ID=

# Shop name fallback (used only if ETSY_SHOP_ID is empty).
ETSY_SHOP_NAME=steadyfocusco

# Optional: an OAuth2 access token. Only needed if you prefer the
# getListingsByShop?state=active endpoint over the public active-listings one.
ETSY_ACCESS_TOKEN=

# Optional: canonical production URL (used for sitemap + Open Graph).
# Defaults to https://steadyfocusco.com if unset.
SITE_URL=
