From 7fa9d40147d2fe5f71127017341f2310dc93f167 Mon Sep 17 00:00:00 2001
From: Arslan Khan <arslankhanwazir@gmail.com>
Date: Mon, 10 Aug 2026 20:01:01 +0000
Subject: [PATCH] fix: correct scatter-state formula that let tasks collapse
 into the central cloud

The scatter position formula only scaled the x-component by 'radius'
- y and z used small fixed amplitudes (1.4 and 0.8) unrelated to
radius. For any task whose angle landed near 90 deg or 270 deg
(cos(angle) ~ 0), x collapsed to ~0 and the task's real distance
from origin dropped to ~1.0 - inside the central cloud sphere
(radius 1.5). This is what made 'Study for exam' appear stuck inside
the glass sphere in the idle/scatter pose, which the animation sits
in for 6 of every ~15 seconds - far more visible than the organized
state my earlier fixes addressed.

Now radius scales the full x/z distance (verified >=3.2 for every
task, safely outside the cloud), and y fans out deterministically by
task index instead of a trig function correlated with x/z, so tasks
don't band together at the same height either.
---
 src/components/hero/Hero3D.ts | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/components/hero/Hero3D.ts b/src/components/hero/Hero3D.ts
index afa8e7a..75830ef 100644
--- a/src/components/hero/Hero3D.ts
+++ b/src/components/hero/Hero3D.ts
@@ -195,13 +195,20 @@ export function initHero3D({ container }: Hero3DOptions) {
     label.position.z = 0.36;
     group.add(label);
 
-    // scatter position
+    // scatter position — radius must control true distance from the
+    // central cloud (radius 1.5), not just the x-component. The old
+    // formula only scaled x by `radius` while y/z used fixed small
+    // amplitudes (1.4, 0.8), so any task whose angle landed near
+    // 90°/270° (cos(angle) ≈ 0) collapsed to a distance of ~1.0 from
+    // origin — inside the cloud sphere. Now radius scales the full
+    // x/z distance, and y fans out deterministically by task index
+    // so items aren't all banded into the same thin y-range either.
     const angle = (i / TASKS.length) * Math.PI * 2;
-    const radius = 3 + (i % 3) * 0.5;
+    const radius = 3.2 + (i % 3) * 0.6;
     const scatter = new THREE.Vector3(
       Math.cos(angle) * radius,
-      Math.sin(angle * 1.7) * 1.4,
-      Math.sin(angle) * 0.8,
+      (i - (TASKS.length - 1) / 2) * 0.55,
+      Math.sin(angle) * radius,
     );
 
     const target = zonePositions[def.zone].clone();
